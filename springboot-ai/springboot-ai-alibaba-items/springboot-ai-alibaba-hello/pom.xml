<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>springboot-ai-alibaba-items</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>springboot-ai-alibaba-hello</artifactId>
    <packaging>jar</packaging>

    <name>springboot-ai-alibaba-hello</name>
    <description>Spring AI Alibaba 入门示例：基于百炼 DashScope 的最简对话应用</description>

    <dependencies>
        <!-- Web：对外提供 REST 接口触发对话 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring AI Alibaba DashScope starter：SAA 1.1.2.2 的 BOM 不管理该 starter，需显式写版本 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
            <version>${spring-ai-alibaba.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- 打包可执行 jar，版本由根工程 pluginManagement 统一管理 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
